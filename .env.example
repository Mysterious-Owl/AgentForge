# --- Required ---
OPENAI_API_KEY=sk-your-key-here

# --- Model pins, one per routing tier (dated, never -latest) ---
SMALL_MODEL=gpt-5.4-nano-2026-03-17
FRONTIER_MODEL=gpt-5.4-mini-2026-03-17

# --- Open-source path (optional) ---
# Point ONLY the small tier at a local OpenAI-compatible server; the frontier stays
# on the vendor. Set the two SMALL_*_COST_PER_1M lines to 0 for a local model.
# SMALL_BASE_URL=http://localhost:11434/v1
# SMALL_MODEL=qwen3:8b
# (OPENAI_BASE_URL moves EVERY call, frontier included - for a proxy or gateway.)

# --- Context pack + Agent Card identity ---
DATA_DIR=data
AGENT_NAME=agentforge-portfolio
AGENT_BASE_URL=http://localhost:8000

# --- Public deploy (app/guard.py). Render sets RENDER and RENDER_EXTERNAL_URL itself. ---
# ADMIN_TOKEN=change-me        # REQUIRED on Render: guards /approve, /audit, /memory
# RATE_LIMIT_PER_MINUTE=30     # POSTs per client per minute (0 = off)
# DAILY_BUDGET_USD=1.00        # model spend per UTC day, all callers together
# TRUST_FORWARDED_FOR=false    # true behind a proxy: key the rate limit on the client IP
# MAX_BODY_BYTES=2097152       # a larger request body is a 413 before it is read

# MODEL_TIMEOUT_S=30           # one model call; tenacity retries it on a timeout

LOG_LEVEL=INFO
